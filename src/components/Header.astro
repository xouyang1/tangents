---
import Settings from './Settings.astro';
import SiteIdentity from './SiteIdentity.astro';
---

<div class="masthead-space">
	<header class="site-masthead" data-site-masthead data-compact="false" data-motion-ready="false">
		<nav>
			<h2><SiteIdentity href="/" label="Xiaoyu Ouyang — Exogradient home" /></h2>
			<div class="nav-right">
				<Settings />
			</div>
		</nav>
	</header>
</div>
<style>
	.masthead-space {
		--masthead-open-height: clamp(72px, 7vw, 92px);
		height: var(--masthead-open-height);
	}
	.site-masthead {
		position: fixed;
		top: 0;
		right: 0;
		left: 0;
		z-index: 100;
		width: 100%;
		height: var(--masthead-open-height);
		margin: 0;
		padding: 0 clamp(36px, 4.5vw, 62px);
		background: #ffffff;
		border-bottom: 1px solid transparent;
		box-sizing: border-box;
		transition: none;
	}
	.site-masthead[data-motion-ready="true"] {
		transition: height 180ms ease, border-color 180ms ease;
	}
	.site-masthead[data-motion-ready="true"] nav {
		transition: padding-top 180ms ease;
	}
	.site-masthead[data-motion-ready="true"] .nav-right {
		transition: margin-top 180ms ease;
	}
	.site-masthead[data-compact="true"] {
		height: 52px;
		border-bottom-color: rgb(var(--gray-light));
	}
	h2 {
		margin: 0;
		font-size: inherit;
		line-height: 1;
	}
	nav {
		display: flex;
		height: 100%;
		padding-top: clamp(1.35rem, 2.4vw, 1.8rem);
		box-sizing: border-box;
		align-items: flex-start;
		justify-content: space-between;
	}
	.site-masthead[data-compact="true"] nav {
		padding-top: 16px;
	}
	.nav-right {
		display: flex;
		align-items: center;
		gap: 0.5em;
		margin-top: -11px;
	}
	.site-masthead[data-compact="true"] .nav-right {
		margin-top: -12px;
	}
	@media (max-width: 980px) {
		.masthead-space {
			--masthead-open-height: 4.6rem;
		}
		.site-masthead {
			padding-right: clamp(1rem, 5vw, 2.5rem);
			padding-left: clamp(1rem, 5vw, 2.5rem);
		}
	}
	@media (max-width: 620px) {
		.masthead-space {
			--masthead-open-height: 4.5rem;
		}
		.site-masthead {
			padding-right: 1rem;
			padding-left: 1rem;
		}
		nav {
			padding-top: 1.35rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.site-masthead[data-motion-ready="true"],
		.site-masthead[data-motion-ready="true"] nav,
		.site-masthead[data-motion-ready="true"] .nav-right {
			transition: none;
		}
	}
</style>

<script>
	const masthead = document.querySelector<HTMLElement>('[data-site-masthead]');
	let mastheadFrame = 0;

	function updateMasthead() {
		mastheadFrame = 0;
		if (!masthead) return;
		const nextState = String(window.scrollY > 0);
		if (masthead.dataset.compact !== nextState) {
			masthead.dataset.compact = nextState;
		}
	}

	function queueMastheadUpdate() {
		if (mastheadFrame) return;
		mastheadFrame = requestAnimationFrame(updateMasthead);
	}

	function restoreMasthead() {
		if (!masthead) return;
		masthead.dataset.motionReady = 'false';
		updateMasthead();
		requestAnimationFrame(() => {
			masthead.dataset.motionReady = 'true';
		});
	}

	window.addEventListener('scroll', queueMastheadUpdate, { passive: true });
	window.addEventListener('pageshow', restoreMasthead);
	restoreMasthead();
</script>
