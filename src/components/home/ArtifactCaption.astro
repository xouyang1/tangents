---
interface Props {
	title: string;
	href?: string;
	actionLabel?: string;
	ariaLabel?: string;
	statusLabel?: string;
}

const { title, href, actionLabel, ariaLabel, statusLabel } = Astro.props;
---

{
	href ? (
		<a class="artifact-caption artifact-caption-link" href={href} aria-label={ariaLabel ?? actionLabel ?? `Open ${title}`}>
			<h2>{title}</h2>
			{actionLabel ? <span class="artifact-action">{actionLabel}</span> : null}
			<span class="artifact-outbound" aria-hidden="true">
				<span>↗</span>
			</span>
		</a>
	) : (
		<div class="artifact-caption">
			<h2>{title}</h2>
			{statusLabel ? <span class="artifact-status">{statusLabel}</span> : null}
		</div>
	)
}
